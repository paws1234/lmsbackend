APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL.  `docker compose` passes its own LMS_DB_* values into the
# container (see the bottom of this file), so these are what `php artisan` and
# the test suite use when they run on the host against the published port.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=lms
DB_USERNAME=lms
DB_PASSWORD=lms
DB_SSLMODE=prefer
# Set to true when the database sits behind a transaction pooler, e.g. a
# Supabase connection string on port 6543 — see DOCKER.md.
#DB_EMULATE_PREPARES=true

# A single connection URI may be used instead of the DB_* values above; Laravel
# applies it last, so a non-empty value here overrides all of them.  It is not
# prefixed LMS_ because the container and a host-run `php artisan` both want it.
# Use Supabase's POOLER hostname — the direct db.<ref>.supabase.co host is
# IPv6-only and unreachable from Docker.  See DOCKER.md.
#DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<INDEX>-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------------------
# Docker (only needed to override docker-compose.yml; `docker compose` reads
# this same .env file, which is why these are prefixed with LMS_).  See DOCKER.md.
# ---------------------------------------------------------------------------
#LMS_BACKEND_PORT=8000
#LMS_DB_HOST=db
#LMS_DB_PORT=5432
#LMS_DB_HOST_PORT=5433
#LMS_DB_DATABASE=lms
#LMS_DB_USERNAME=lms
#LMS_DB_PASSWORD=lms
#LMS_DB_SSLMODE=prefer
#LMS_DB_EMULATE_PREPARES=false
#LMS_APP_KEY=base64:/bdLq63o8GHzO/KFiXXVmRgShpXRSS2okcRmfwNbbwM=

# To run the API against Supabase instead of the local `db` container, swap in
# the values from the project's Project settings -> Database page.  Keep the
# password in .env (gitignored) and never in docker-compose.yml.
#LMS_DB_HOST=aws-0-<region>.pooler.supabase.com
#LMS_DB_PORT=6543
#LMS_DB_DATABASE=postgres
#LMS_DB_USERNAME=postgres.<project-ref>
#LMS_DB_PASSWORD=
#LMS_DB_SSLMODE=require
#LMS_DB_EMULATE_PREPARES=true

